# Copy to .env.local for local development. On Vercel set the same names in
# Project Settings > Environment Variables. NEXT_PUBLIC_* values are baked in at build time.

# Public site address (canonical URLs, sitemaps, feeds, OAuth metadata). Required for Vercel production builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase: Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional. A PRIVATE Storage bucket for uploads (default "uploads"); create it in Supabase > Storage.
# SUPABASE_STORAGE_BUCKET=uploads

# Admin login for /admin. Change either value in Vercel and redeploy to change the login (password: 8+ characters, longer is better).
ADMIN_EMAIL=you@medicalaccountant.ie
ADMIN_PASSWORD=a-long-password-here

# Programmatic publishing (POST /api/posts/*, the local MCP server, /api/revalidate):  openssl rand -hex 32
POSTS_API_KEY=your_secure_api_key_here
REVALIDATION_SECRET=your_secret_here

# Resend (form notification emails)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# IndexNow key, 32 hex chars:  openssl rand -hex 16
INDEXNOW_KEY=your_32_char_hex_key_here

# Enquiry form (/api/enquiry) forwards JSON to this URL (email service, CRM, Zapier...). 503 until set.
# ENQUIRY_WEBHOOK_URL=

# Tracking (defaults are the codes live on the WordPress site; set to "" to switch one off)
# NEXT_PUBLIC_GA4_ID=G-Y4YRH7NX8L
# NEXT_PUBLIC_GADS_ID=AW-1037014354
# NEXT_PUBLIC_GADS_LEAD_LABEL=
# NEXT_PUBLIC_META_PIXEL_ID=218136276851539
# NEXT_PUBLIC_GSC_TOKEN=

# Optional: serve uploads from a public domain instead of /files/*
# NEXT_PUBLIC_R2_PUBLIC_URL=
