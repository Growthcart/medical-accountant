# Secrets live in .dev.vars (see .dev.vars.example), not here: `npm run dev` reads them from there.
# Only build-time, non-secret values go in .env.local. Defaults are the codes live on the WordPress site;
# set one to "" to switch it off. In CI/production set these in .github/workflows/deploy.yml.
# NEXT_PUBLIC_GA4_ID=G-Y4YRH7NX8L
# NEXT_PUBLIC_GADS_ID=AW-1037014354
# NEXT_PUBLIC_GADS_LEAD_LABEL=
# NEXT_PUBLIC_META_PIXEL_ID=218136276851539
# NEXT_PUBLIC_GSC_TOKEN=

# One-off migration scripts only (scripts/export-supabase.mjs, scripts/export-storage.mjs); delete after the move.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=uploads
